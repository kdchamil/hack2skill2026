# Copy to .env for local runs. Never commit real values (.env is git-ignored).
# Auth is Application Default Credentials only; there are no API keys.
#   gcloud auth application-default login

# Google Cloud project used for Vertex AI calls. Required when FIVESEC_MOCK=0.
GOOGLE_CLOUD_PROJECT=
# Vertex AI location. Default: global.
GOOGLE_CLOUD_LOCATION=global

# Model IDs (all overridable). Verify the newest GA Flash/Pro and Gemini-TTS IDs
# on Vertex before deploying; the values below are placeholders.
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
TTS_MODEL=gemini-2.5-flash-preview-tts

# 1 = no cloud calls; fixtures + template commentary. Default 1 when no project is set.
# 0 = live Vertex AI calls.
FIVESEC_MOCK=1

# Agent pipeline: adk (default) or direct.
FIVESEC_PIPELINE=adk

# HTTP port. Cloud Run injects PORT=8080.
PORT=8080

# Optional: directory of the built PWA. The Dockerfile sets this to /app/web/dist.
# WEB_DIST=web/dist
