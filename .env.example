# Copy to .env for local runs. Never commit real values (.env is git-ignored).
# Auth is Application Default Credentials only; there are no API keys.
#   gcloud auth application-default login

# Google Cloud project used for Vertex AI calls. Required when FIVESEC_MOCK=0.
GOOGLE_CLOUD_PROJECT=
# Vertex AI location. Default: global.
GOOGLE_CLOUD_LOCATION=global

# Model IDs (all overridable). These match the defaults in backend/app/config.py.
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
# GEMINI_COMMENTARY_MODEL=gemini-3.5-flash-lite   (defaults to GEMINI_FLASH_MODEL)
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro
TTS_MODEL=gemini-2.5-flash-tts
# TTS_VOICE=Kore

# 1 = no cloud calls; fixtures + template commentary. Default 1 when no project is set.
# 0 = live Vertex AI calls.
FIVESEC_MOCK=1

# Agent pipeline: adk (default) or direct.
FIVESEC_PIPELINE=adk

# HTTP port. Cloud Run injects PORT=8080.
PORT=8080

# Optional: directory of the built PWA. The Dockerfile sets this to /app/web/dist.
# WEB_DIST=web/dist

# Cache: memory | firestore. Default: firestore when GOOGLE_CLOUD_PROJECT is set and FIVESEC_MOCK is off, else memory.
# Firestore (native mode, ADC) holds label extractions, commentary and TTS audio only; never photos or user data.
# FIVESEC_CACHE=memory
# Days before a cached doc expires (written to expires_at; also set a Firestore TTL policy on that field).
# FIVESEC_CACHE_TTL_DAYS=30

# Rate limits (per instance, in-process). Per client IP per minute; global per day (0 = no daily cap).
# FIVESEC_RATE_PER_MIN=20
# FIVESEC_DAILY_BUDGET=300
# FIVESEC_RATE_LIMIT=0 disables limiting.
